# basic setup
PORT=3000
FINGER_PORT=7979
BASE_URL=https://finger.farm
BASE_FINGER_HOST=finger.farm
ALLOW_REGISTRATION=true
SHOW_PUBLIC_USERS=true


# Auth Providers (Leave blank to disable)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=

AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=

DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

SESSION_SECRET=your_long_random_session_secret

# DATABASE
# Set DB_TYPE to 'sqlite', 'firebase', 'postgres', 'mysql', 'mongo', 'supabase', or 'redis'
DB_TYPE=sqlite
# SQLite configuration (optional, defaults to ./db/fingerfarm.sqlite3)
SQLITE_DB_PATH=./db/fingerfarm.sqlite3
# Firebase configuration
FIREBASE_CERT_PATH=/path/to/your/firebase-service-account.json
# Postgres configuration
POSTGRES_URL=postgresql://user:password@localhost:5432/fingerfarm
# MySQL configuration
MYSQL_URL=mysql://user:password@localhost:3306/fingerfarm
# MongoDB configuration
MONGO_URL=mongodb://localhost:27017/fingerfarm
# Supabase configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# Redis configuration
REDIS_URL=redis://localhost:6379
