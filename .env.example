GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
SESSION_SECRET=your_long_random_session_secret
PORT=3000
FINGER_PORT=7979
BASE_URL=https://finger.farm
BASE_FINGER_HOST=finger.farm

# Database Settings
# Set DB_TYPE to 'sqlite', 'firebase', 'postgres', 'mysql', 'mongo', 'supabase', or 'redis'
DB_TYPE=sqlite
# Firebase configuration
FIREBASE_CERT_PATH=/path/to/your/firebase-service-account.json
# Postgres configuration
POSTGRES_URL=postgresql://user:password@localhost:5432/fingerfarm
# MySQL configuration
MYSQL_URL=mysql://user:password@localhost:3306/fingerfarm
# MongoDB configuration
MONGO_URL=mongodb://localhost:27017/fingerfarm
# Supabase configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# Redis configuration
REDIS_URL=redis://localhost:6379
